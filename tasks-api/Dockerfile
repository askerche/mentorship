# Используем Alpine версию (легкая и быстрая)
FROM golang:1.24-alpine

WORKDIR /app

# 1. Сначала копируем только файлы зависимостей!
COPY go.mod go.sum ./

# 2. Скачиваем зависимости. 
# Если go.mod не менялся, Docker возьмет этот шаг из кэша (мгновенно)
RUN go mod download

# 3. Теперь копируем исходный код
COPY . .

# 4. Собираем (добавил флаги для уменьшения размера бинарника, опционально)
RUN go build -o /app/main .

# 5. Запускаем
CMD ["/app/main"]


